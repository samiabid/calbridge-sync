# Database (Railway will provide this automatically)
DATABASE_URL="postgresql://<db_user>:<db_password>@<db_host>:5432/<db_name>"

# Google OAuth Credentials (Get from Google Cloud Console)
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/auth/google/callback"

# App Configuration
SESSION_SECRET="your-session-secret-change-this"
TOKEN_ENCRYPTION_KEY="set-a-long-random-string-for-token-encryption"
NODE_ENV="development"
PORT=3000

# Private app access control
# In production, only these emails can sign into the app.
ALLOWED_LOGIN_EMAILS="owner@example.com"
# In production, only these Google accounts can be connected for calendar sync.
ALLOWED_GOOGLE_ACCOUNT_EMAILS="owner@example.com,work@example.com"

# Public URL (Set to your Railway URL in production)
PUBLIC_URL="http://localhost:3000"

# Sync safety limits
# Bounds future recurring-event expansion during webhooks and initial backfills.
SYNC_FUTURE_DAYS=365
# Globally pace Google API calls and catch up missed webhook changes every five minutes.
GOOGLE_API_MIN_INTERVAL_MS=125
SYNC_CATCHUP_INTERVAL_MS=300000
# Retain sync audit history for six months.
SYNC_AUDIT_RETENTION_DAYS=180

# Production canonical values
# PUBLIC_URL="https://calendar.samiabid.com"
# GOOGLE_REDIRECT_URI="https://calendar.samiabid.com/auth/google/callback"
# ALLOWED_LOGIN_EMAILS="owner@example.com"
# ALLOWED_GOOGLE_ACCOUNT_EMAILS="owner@example.com,work@example.com"
# INTERNAL_CRON_TOKEN="set-a-long-random-string-for-protected-internal-actions"
# SYNC_FUTURE_DAYS=365
# ALERT_WEBHOOK_URL="https://your-alert-endpoint.example.com"
# Optional dedicated synthetic canary. Do not use a real meeting.
# SYNC_CANARY_SYNC_ID="dedicated-sync-id"
# SYNC_CANARY_SOURCE_EVENT_ID="stable-source-event-id"
# SYNC_CANARY_DIRECTION="source_to_target"
